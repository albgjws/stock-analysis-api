      "h2": "8.2 涨跌停检测",
      "bullets": [
        "优先使用接口返回的涨跌停价",
        "降级: 涨幅>=9.6% 为涨停，跌幅<=-9.6%为跌停",
        "两个条件独立判断"
      ]
    },
    {
      "h2": "8.3 封单量逻辑",
      "bullets": [
        "涨停封单 = 买一量 (buy1Vol)",
        "跌停封单 = 卖一量 (sell1Vol)",
        "封单额 = 封单量(手) x 100 x 涨跌停价"
      ]
    },
